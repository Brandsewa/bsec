# Superuser (only used by docker-compose postgres + role bootstrap)
POSTGRES_PASSWORD=postgres
# Role passwords (bootstrap sets these)
APP_OWNER_PASSWORD=owner_dev
APP_RW_PASSWORD=rw_dev
APP_SAAS_PASSWORD=saas_dev
APP_PLATFORM_PASSWORD=platform_dev
# Per-process connection strings
DATABASE_URL_OWNER=postgres://app_owner:owner_dev@localhost:5432/bsec   # migrations only
DATABASE_URL_RW=postgres://app_rw:rw_dev@localhost:5432/bsec            # web, worker
DATABASE_URL_SAAS=postgres://app_saas:saas_dev@localhost:5432/bsec      # web, worker: self-service signup/billing/trial sweep (optional; disabled when unset)
DATABASE_URL_PLATFORM=postgres://app_platform:platform_dev@localhost:5432/bsec  # platform only
LOG_LEVEL=info

# Production tenant secrets encryption key (required in production, AES-256 32-byte string or 64-char hex)
# Code reads TENANT_SECRETS_KEY, falls back to ENCRYPTION_KEY
# Leave blank locally (dev fallback key is used). In production generate one: openssl rand -hex 32
TENANT_SECRETS_KEY=
# ENCRYPTION_KEY=

# Admin sign-in (Better Auth). Required for the admin to work; in production use https URLs.
BETTER_AUTH_URL=http://localhost:3000
# 32+ random characters: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Optional: comma-separated admin origins allowed to call the API (default derives from BETTER_AUTH_URL)
# ADMIN_ORIGINS=http://localhost:5173

# Public image delivery for storefront blocks (set one). Cloudflare Images: https://imagedelivery.net/<account-hash>
CF_IMAGES_DELIVERY_URL=
# R2_PUBLIC_URL=https://media.example.com
