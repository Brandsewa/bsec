# Superuser (only used by docker-compose postgres + role bootstrap)
POSTGRES_PASSWORD=postgres
# Role passwords (bootstrap sets these)
APP_OWNER_PASSWORD=owner_dev
APP_RW_PASSWORD=rw_dev
APP_PLATFORM_PASSWORD=platform_dev
# Per-process connection strings
DATABASE_URL_OWNER=postgres://app_owner:owner_dev@localhost:5432/bsec   # migrations only
DATABASE_URL_RW=postgres://app_rw:rw_dev@localhost:5432/bsec            # web, worker
DATABASE_URL_PLATFORM=postgres://app_platform:platform_dev@localhost:5432/bsec  # platform only
LOG_LEVEL=info

# Production tenant secrets encryption key (required in production, AES-256 32-byte string or 64-char hex)
# Code reads TENANT_SECRETS_KEY, falls back to ENCRYPTION_KEY
# Leave blank locally (dev fallback key is used). In production generate one: openssl rand -hex 32
TENANT_SECRETS_KEY=
# ENCRYPTION_KEY=
