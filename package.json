{
  "name": "bsec",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:fast": "turbo run test:fast",
    "test:heavy": "turbo run test:heavy",
    "docs:check": "node scripts/check-docs.mjs",
    "db:migrate": "pnpm --filter @bs/db migrate",
    "db:generate": "pnpm --filter @bs/db generate",
    "lint:fast": "oxlint",
    "db:up": "docker compose up -d postgres migrate",
    "test:db:up": "docker compose -f docker-compose.test-db.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test-db.yml down"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "oxlint": "1.86.0",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
