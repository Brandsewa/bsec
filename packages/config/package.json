{
  "name": "@bs/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./eslint": "./eslint/index.js",
    "./eslint/rules": "./eslint/rules/index.js",
    "./tailwind.css": "./tailwind.css",
    "./vitest": "./vitest.js",
    "./bundle-node": "./build/bundle-node.js"
  },
  "scripts": {
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "test:fast": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.1",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "vitest": "5.0.3"
  }
}
