{
  "name": "@bs/block-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./preview": "./src/preview.ts"
  },
  "scripts": {
