{
  "name": "@bs/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jobs": "./src/jobs.ts",
    "./pricing": "./src/orders/pricing.ts",
    "./addresses": "./src/markets/addresses.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/*.int.test.ts'",
    "test:heavy": "vitest run int.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "@bs/auth": "workspace:*",
    "@bs/blocks": "workspace:*",
    "@bs/db": "workspace:*",
    "@bs/payments": "workspace:*",
    "@bs/shipping": "workspace:*",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.2.1",
    "pdfkit": "0.20.2",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bs/config": "workspace:*",
    "@bs/contracts": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
