{
  "name": "@bs/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./tenant-table": "./src/tenant-table.ts",
    "./queues": "./src/queues.ts",
    "./bootstrap": "./src/scripts/bootstrap-roles.ts",
    "./migrate": "./src/scripts/migrate.ts",
    "./test-env": "./test-support/test-env.ts",
    "./test-fixtures": "./test-support/platform-fixtures.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/*.int.test.ts'",
    "test:heavy": "vitest run int.test.ts",
    "bootstrap": "tsx src/scripts/bootstrap-cli.ts",
    "migrate": "tsx src/scripts/migrate-cli.ts",
    "generate": "drizzle-kit generate",
    "build": "node build.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "pg-boss": "12.37.0"
  },
  "devDependencies": {
    "@bs/config": "workspace:*",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@testcontainers/postgresql": "12.2.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
