{
  "name": "@bs/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node build.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/*.int.test.ts'",
    "test:heavy": "vitest run int.test.ts --no-file-parallelism",
    "seed:templates": "tsx src/seed-templates-cli.ts"
  },
  "dependencies": {
    "@bs/auth": "workspace:*",
    "@bs/contracts": "workspace:*",
    "@bs/db": "workspace:*",
    "@bs/domain": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@orpc/openapi": "1.15.7",
    "@orpc/server": "1.15.7",
    "@sentry/node": "11.8.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@bs/config": "workspace:*",
    "@types/node": "24.19.0",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
