{
  "name": "@bs/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node build.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "test": "vitest run --passWithNoTests",
    "test:fast": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bs/domain": "workspace:*",
    "@sentry/node": "11.0.0"
  },
  "devDependencies": {
    "@bs/config": "workspace:*",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
